# ---------------------------------------------------------------------------
# Line-ending policy
#
# Text files are stored with LF in the repository and checked out with LF on
# every platform. Without this, a working copy that holds LF while the index
# holds CRLF shows up as "modified" in `git status` even though the content is
# byte-identical after normalization, which is pure noise.
# ---------------------------------------------------------------------------
* text=auto eol=lf

# Explicitly binary — never touched by text conversion.
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.jar   binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary

# Windows-only build scripts keep CRLF so they stay double-clickable.
*.bat text eol=crlf
*.cmd text eol=crlf
